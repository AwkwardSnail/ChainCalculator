<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for Chain Calc.
  Identity Name, Identity Publisher and PublisherDisplayName must match Partner Center
  (Product management > Product identity) exactly, including the "Akward" spelling.
  Store ID 9NS3M6ZN477C, package family name AkwardSnail.ChainCalc_ktfm57pxn63ft.
  pack.ps1 sets Identity Version from its -Version parameter.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="AkwardSnail.ChainCalc"
    Publisher="CN=A55585C2-FE40-4ED1-9B77-46466AE9C532"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Chain Calc</DisplayName>
    <PublisherDisplayName>aWkward Snail</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="ChainCalculator" Executable="ChainCalculator.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Chain Calc"
        Description="A five-cell calculator where each cell applies its own operation to the running result."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0D0F0C" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
