<Window x:Class="ChainCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chain Calculator"
        Icon="app.ico"
        Width="600"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource GreenBrush}"
        FontFamily="Consolas, Courier New"
        FontSize="20pt">
    <Border Margin="16"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel>
            <Border Style="{StaticResource Row}" BorderBrush="{StaticResource GreenDimBrush}" TextElement.FontSize="12pt" TextElement.Foreground="{StaticResource GreenDimBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OP" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="VALUE" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="RUNNING" />
                </Grid>
            </Border>

            <StackPanel x:Name="RowsPanel" />

            <DockPanel Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Right" x:Name="ResultText" FontWeight="Bold" Text="0" />
                <TextBlock FontWeight="Bold" Text="Result" />
            </DockPanel>

            <Button x:Name="ClearButton"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ClearButton}"
                    Content="Clear"
                    Click="ClearButton_Click" />
        </StackPanel>
    </Border>
</Window>
