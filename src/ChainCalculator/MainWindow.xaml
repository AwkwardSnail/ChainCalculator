<Window x:Class="ChainCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chain Calc"
        Icon="app.ico"
        Width="600"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource GreenBrush}"
        FontFamily="Consolas, Courier New"
        FontSize="20pt">
    <Border Margin="16"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel>
            <Border Style="{StaticResource Row}" BorderBrush="{StaticResource GreenDimBrush}" TextElement.FontSize="12pt" TextElement.Foreground="{StaticResource GreenDimBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="OP" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="( )" />
                    <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="VALUE" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="RUNNING" />
                </Grid>
            </Border>

            <StackPanel x:Name="RowsPanel" />

            <DockPanel Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Right" x:Name="ResultText" FontWeight="Bold" Text="0" />
                <TextBlock FontWeight="Bold" Text="Result" />
            </DockPanel>

            <!-- The whole calculation, divisions as fractions; wraps between terms if it's long. -->
            <WrapPanel x:Name="ExpressionPanel"
                       Margin="0,8,0,0"
                       MinHeight="32"
                       TextElement.FontSize="18pt"
                       AutomationProperties.Name="Calculation" />

            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton"
                        Margin="0,0,12,0"
                        MinWidth="150"
                        Style="{StaticResource ClearButton}"
                        Content="Copy result"
                        ToolTip="Copy the result"
                        Click="CopyButton_Click" />
                <Button x:Name="ClearButton"
                        Style="{StaticResource ClearButton}"
                        Content="Clear"
                        Click="ClearButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
